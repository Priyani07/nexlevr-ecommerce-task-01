*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,sans-serif;background:#f7f5ef;color:#171717}a{text-decoration:none;color:inherit}button,.cta{border:0;border-radius:12px;padding:12px 18px;background:#171717;color:white;cursor:pointer;font-weight:700}button:hover,.cta:hover{opacity:.86}nav{height:76px;padding:0 6%;display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid #e7e4dc;position:sticky;top:0;z-index:10}.brand{font-size:25px;font-weight:900}.navlinks{display:flex;align-items:center;gap:22px}.pill{background:#171717;color:#fff;padding:10px 15px;border-radius:10px}.hero{min-height:calc(100vh - 76px);padding:8% 7%;display:grid;grid-template-columns:1.5fr 1fr;gap:50px;align-items:center;background:linear-gradient(135deg,#fffdf5,#ece9df)}h1{font-size:clamp(48px,7vw,88px);line-height:.95;margin:16px 0 24px;letter-spacing:-4px}.hero p{font-size:19px;line-height:1.7;max-width:700px;color:#555}.eyebrow{font-size:12px;letter-spacing:2px;font-weight:800;color:#777}.heroCard{background:#171717;color:white;border-radius:28px;padding:40px;display:grid;gap:8px;box-shadow:0 25px 70px #0002}.heroCard b{font-size:38px;margin-top:20px}.heroCard span{color:#aaa}.page{padding:60px 7%;min-height:70vh}.page h2{font-size:50px;letter-spacing:-2px;margin:10px 0 35px}.sectionHead{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:40px}.sectionHead form{display:flex;gap:10px}input{width:100%;border:1px solid #d8d5cc;border-radius:10px;padding:13px 14px;background:#fff;font:inherit}.sectionHead input{width:300px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px}.card{background:#fff;border:1px solid #e7e4dc;border-radius:20px;overflow:hidden}.card img{width:100%;aspect-ratio:1;object-fit:cover}.cardbody{padding:20px}.cardbody h3{margin:7px 0}.cardbody p{color:#666;min-height:45px}.price{font-size:22px;font-weight:800;margin:15px 0}.detail{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.detail img{width:100%;max-height:600px;object-fit:cover;border-radius:28px}.detail h2{margin-bottom:10px}.auth{min-height:75vh;display:grid;place-items:center;padding:50px 20px}.auth form{background:#fff;width:min(440px,100%);padding:38px;border:1px solid #e7e4dc;border-radius:24px;display:grid;gap:15px}.auth h2{font-size:42px;margin:0 0 8px}.error{color:#b42318}.cartlist{display:grid;gap:15px}.cartrow{display:grid;grid-template-columns:80px 1fr 90px auto;align-items:center;gap:20px;padding:15px;background:#fff;border:1px solid #e7e4dc;border-radius:15px}.cartrow img{width:80px;height:80px;object-fit:cover;border-radius:10px}.summary{margin-top:25px;display:flex;justify-content:flex-end;gap:25px;align-items:center}.order,.panel{background:#fff;border:1px solid #e7e4dc;border-radius:16px;padding:20px;margin-bottom:12px}.order{display:flex;gap:25px;align-items:center}.order span:nth-child(2){margin-left:auto}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:30px}.stats div{background:#171717;color:#fff;border-radius:20px;padding:28px}.stats b{font-size:42px;display:block}.stats span{color:#aaa}.adminGrid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.panel form{display:grid;gap:12px}footer{padding:30px 7%;background:#171717;color:white;display:flex;justify-content:space-between}footer span{color:#aaa}.loader{padding:50px;text-align:center}@media(max-width:800px){nav{padding:0 4%}.navlinks{gap:10px;font-size:13px}.hero,.detail,.adminGrid{grid-template-columns:1fr}.page{padding:40px 5%}.sectionHead{display:block}.sectionHead form{margin-top:20px}.sectionHead input{width:100%}h1{letter-spacing:-2px}.cartrow{grid-template-columns:60px 1fr}.cartrow input,.cartrow button{grid-column:2}.order{flex-wrap:wrap}footer{display:block}footer span{display:block;margin-top:8px}}