import {Link} from "react-router-dom";export default function Home(){return <main className="hero"><div><span className="eyebrow">NEXLEVR • LEVEL 02</span><h1>Everything you need, in one modern store.</h1><p>Explore products, manage your cart, place demo orders and experience a complete React + Node + MongoDB e-commerce workflow.</p><Link className="cta" to="/products">Explore Products</Link></div><div className="heroCard"><b>30+</b><span>Demo products</span><b>JWT</b><span>Secure authentication</span><b>MongoDB</b><span>Persistent data</span></div></main>}